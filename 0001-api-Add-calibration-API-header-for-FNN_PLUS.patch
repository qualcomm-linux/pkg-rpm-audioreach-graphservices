From bec06746f322777e687178e408d909de5a8c2e3b Mon Sep 17 00:00:00 2001
From: Kumar Anurag <kumar.singh@oss.qualcomm.com>
Date: Tue, 3 Nov 2026 04:34:55 -0800
Subject: [PATCH] api: Add calibration API header for FNN_PLUS

Add fnn_plus_calibration_api_fvxv.h defining
PARAM_ID_FNN_PLUS_DOA_ESTIMATE_MONITOR_WITH_TIMESTAMP.

Also list the new header in spf/Makefile.am's api_sources so it is
installed/distributed along with the other module API headers.

CRs-Fixed: 4733242

Signed-off-by: Kumar Anurag <kumar.singh@oss.qualcomm.com>
Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 spf/Makefile.am                               |  3 +-
 .../modules/fnn_plus_calibration_api_fvxv.h   | 51 +++++++++++++++++++
 2 files changed, 53 insertions(+), 1 deletion(-)
 create mode 100644 spf/api/modules/fnn_plus_calibration_api_fvxv.h

diff --git a/spf/Makefile.am b/spf/Makefile.am
index 5b51abf..afd5313 100644
--- a/spf/Makefile.am
+++ b/spf/Makefile.am
@@ -139,7 +139,8 @@ spf_sources = ./api/apm/apm_api.h \
                 ./api/modules/us_tone_renderer_api.h \
                 ./api/modules/mma_api.h \
                 ./api/modules/sound_dose_api.h \
-                ./api/modules/sdz_api.h
+                ./api/modules/sdz_api.h \
+                ./api/modules/fnn_plus_calibration_api_fvxv.h
 
 asps_sources =  ./api/asps/asps_ads_usecase_api.h \
                 ./api/asps/asps_upd_usecase_api.h \
diff --git a/spf/api/modules/fnn_plus_calibration_api_fvxv.h b/spf/api/modules/fnn_plus_calibration_api_fvxv.h
new file mode 100644
index 0000000..cab0733
--- /dev/null
+++ b/spf/api/modules/fnn_plus_calibration_api_fvxv.h
@@ -0,0 +1,51 @@
+/*=======================================================================
+Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+All rights reserved.
+Confidential and Proprietary - Qualcomm Technologies, Inc.
+=========================================================================*/
+
+#ifndef __FNN_PLUS_CALIBRATION_API_FVXV__
+#define __FNN_PLUS_CALIBRATION_API_FVXV__
+
+#include "module_cmn_api.h"
+
+#define PARAM_ID_FNN_PLUS_DOA_ESTIMATE_MONITOR_WITH_TIMESTAMP 0x08001B97
+
+typedef struct fnn_plus_doa_estimate_monitor_param_with_ts_t fnn_plus_doa_estimate_monitor_param_with_ts_t;
+/** @h2xmlp_parameter    {"PARAM_ID_FNN_PLUS_DOA_ESTIMATE_MONITOR_WITH_TIMESTAMP",
+   PARAM_ID_FNN_PLUS_DOA_ESTIMATE_MONITOR_WITH_TIMESTAMP}
+    @h2xmlp_description  {DOA Estimate Monitor with timestamp parameters}
+    @h2xmle_readOnly     {true}
+    @h2xmlp_toolPolicy   {RTM}
+*/
+#include "spf_begin_pack.h"
+#include "spf_begin_pragma.h"
+struct fnn_plus_doa_estimate_monitor_param_with_ts_t
+{
+   int16_t speech_probability_q15;
+
+   uint16_t reserved;
+
+   int16_t current_talker_doa[2];
+
+   uint16_t polar_activity_axis0_length;
+
+   uint16_t polar_activity_axis1_length;
+
+   int16_t polar_activity_axis0[0];
+
+   int16_t angle_mapping_axis0[0];
+
+   int16_t polar_activity_axis1[0];
+
+   int16_t angle_mapping_axis1[0];
+
+   uint32_t session_time_lsw;
+
+   uint32_t session_time_msw;
+}
+#include "spf_end_pragma.h"
+#include "spf_end_pack.h"
+;
+
+#endif /* __FNN_PLUS_CALIBRATION_API_FVXV__ */
-- 
